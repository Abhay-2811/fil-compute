# Core API — copy to .env and fill in

# Server
PORT=3000

# Node registry: nodeid -> URL, or object with url + payout_address for EVM
# Single node (no EVM payout):
# NODES={"node-001":"https://compute.example.com"}
# With EVM payout address:
# NODES={"node-001":{"url":"https://compute.example.com","payout_address":"0x..."}}

# Optional: node payout addresses only (if NODES has no payout_address)
# NODE_PAYOUT_ADDRESSES={"node-001":"0x..."}

# Escrow: "memory" (default, for dev) or "evm"
ESCROW_PROVIDER=memory

# --- Only when ESCROW_PROVIDER=evm ---
# ESCROW_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
# ESCROW_CONTRACT_ADDRESS=0x...
# ESCROW_SIGNER_PRIVATE_KEY=0x...
# ESCROW_CU_TO_WEI=1000000000000
