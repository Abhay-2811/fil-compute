{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://datatzen.io/schemas/start.json",
  "title": "Start",
  "description": "Core → Node: start job execution",
  "definitions": {
    "ComputeRequirements": {
      "type": "object",
      "required": ["cpu_cores", "memory_mb"],
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0.1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "gpu": { "type": "object", "properties": { "count": { "type": "integer" }, "model": { "type": "string" } } }
      }
    },
    "DockerSpec": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "workdir": { "type": "string" }
      }
    }
  },
  "type": "object",
  "required": ["job_id", "attempt_id", "cid", "compute_requirements", "docker", "timeout_by"],
  "properties": {
    "job_id": { "type": "string" },
    "attempt_id": { "type": "string", "description": "Unique per attempt; prevents double execution / double pay" },
    "cid": { "type": "string", "description": "Input data CID; node mounts as read-only volume" },
    "compute_requirements": { "$ref": "#/definitions/ComputeRequirements" },
    "docker": { "$ref": "#/definitions/DockerSpec" },
    "timeout_by": { "type": "integer", "minimum": 1, "description": "Max wall time in seconds" }
  }
}
