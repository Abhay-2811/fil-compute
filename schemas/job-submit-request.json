{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://datatzen.io/schemas/job-submit-request.json",
  "title": "JobSubmitRequest",
  "type": "object",
  "required": ["nodeid", "cid", "compute_requirements", "docker", "timeout_by", "max_cost_cu"],
  "properties": {
    "nodeid": { "type": "string" },
    "cid": { "type": "string" },
    "compute_requirements": {
      "type": "object",
      "required": ["cpu_cores", "memory_mb"],
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0.1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "gpu": { "type": "object", "properties": { "count": { "type": "integer" }, "model": { "type": "string" } } }
      }
    },
    "docker": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "workdir": { "type": "string" }
      }
    },
    "timeout_by": { "type": "integer", "minimum": 1 },
    "max_cost_cu": { "type": "number", "minimum": 0 },
    "client_request_id": { "type": "string" }
  }
}
