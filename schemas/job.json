{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fil-compute.io/schemas/job.json",
  "title": "Job",
  "description": "Job submit request and job resource (Core API)",
  "definitions": {
    "ComputeRequirements": {
      "type": "object",
      "required": ["cpu_cores", "memory_mb"],
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0.1, "description": "CPU cores requested" },
        "memory_mb": { "type": "integer", "minimum": 1, "description": "Memory in MB" },
        "gpu": {
          "type": "object",
          "description": "Optional GPU requirements (static for v0)",
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "model": { "type": "string" }
          }
        }
      }
    },
    "DockerSpec": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "description": "Docker image (prefer digest pinning)" },
        "command": { "type": "array", "items": { "type": "string" }, "description": "Override CMD" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "workdir": { "type": "string" }
      }
    }
  },
  "oneOf": [
    {
      "title": "JobSubmitRequest",
      "type": "object",
      "required": ["nodeid", "cid", "compute_requirements", "docker", "timeout_by", "max_cost_cu"],
      "properties": {
        "nodeid": { "type": "string", "description": "Target node identity (public)" },
        "cid": { "type": "string", "description": "Input data CID (assume node has it)" },
        "compute_requirements": { "$ref": "#/definitions/ComputeRequirements" },
        "docker": { "$ref": "#/definitions/DockerSpec" },
        "timeout_by": { "type": "integer", "minimum": 1, "description": "Max wall time in seconds" },
        "max_cost_cu": { "type": "number", "minimum": 0, "description": "Upper bound for escrow lock" },
        "client_request_id": { "type": "string", "description": "Optional idempotency key" }
      }
    },
    {
      "title": "JobResource",
      "type": "object",
      "required": ["job_id", "status"],
      "properties": {
        "job_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "SUBMITTED",
            "PREFLIGHTING",
            "ESCROW_LOCKED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED_PREFLIGHT",
            "FAILED_CONTAINER",
            "FAILED_NODE"
          ]
        },
        "result_cid": { "type": "string", "description": "On success" },
        "cu_used": { "type": "number", "description": "Final compute units charged" },
        "receipt": { "type": "object", "description": "Node-signed receipt on success; see receipt.json schema" },
        "error": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
